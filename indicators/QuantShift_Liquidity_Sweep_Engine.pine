//@version=5
indicator("QuantShift AI · Liquidity Sweep Engine [Open-Source]", overlay=true)

// ==========================================
// QuantShift AI - EP01 Institutional Liquidity Sweep Engine
// GitHub: https://github.com/QuantShift-AI/open-quant-signals
// YouTube: https://youtube.com/@aitrading
// License: MIT (100% Free & Open-Source)
// ==========================================

length = input.int(20, "Swing High/Low Lookback", minval=5)
atrMultiplier = input.float(1.5, "ATR Filter Multiplier", minval=0.5)

// Swing Points Calculation
highestHigh = ta.highest(high[1], length)
lowestLow = ta.lowest(low[1], length)
atr = ta.atr(14)

// Bullish Liquidity Sweep: Price pierced below lowestLow, but closes back above it (Failed Breakdown)
bullishSweep = (low < lowestLow) and (close > lowestLow) and ((lowestLow - low) < (atr * atrMultiplier))

// Bearish Liquidity Sweep: Price pierced above highestHigh, but closes back below it (Failed Breakout)
bearishSweep = (high > highestHigh) and (close < highestHigh) and ((high - highestHigh) < (atr * atrMultiplier))

// Plotting Signals
plotshape(bullishSweep, title="Bullish Liquidity Sweep (Long)", location=location.belowbar, color=color.new(#00FF66, 0), style=shape.triangleup, size=size.normal, text="WHALE BUY")
plotshape(bearishSweep, title="Bearish Liquidity Sweep (Short)", location=location.abovebar, color=color.new(#FF3B30, 0), style=shape.triangledown, size=size.normal, text="WHALE DUMP")

// Reference Level Lines
plot(highestHigh, "Institutional Buy Liquidity Pool", color=color.new(#FF3B30, 40), style=plot.style_linebr)
plot(lowestLow, "Institutional Sell Liquidity Pool", color=color.new(#00FF66, 40), style=plot.style_linebr)

// Dynamic Alerts
alertcondition(bullishSweep, title="Bullish Liquidity Sweep Alert", message="QuantShift Alert: Smart Money Bullish Liquidity Sweep detected on {{ticker}}!")
alertcondition(bearishSweep, title="Bearish Liquidity Sweep Alert", message="QuantShift Alert: Smart Money Bearish Liquidity Sweep detected on {{ticker}}!")
